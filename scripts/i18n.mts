/**
 * Translation table → code. `app/_i18n/messages.csv` is the only place interface text is written; this script checks
 * it and generates the two files the app imports. Run it after editing the CSV (decision #59).
 *
 *   node scripts/i18n.mts           check, sort and normalize the CSV, regenerate the code
 *   node scripts/i18n.mts --check   check only; fails when the CSV is unsorted or the generated code is stale (CI)
 *
 * CSV: UTF-8, header `key,en,ko,note`, one row per key, sorted by key. `en` is required; an empty `ko` falls back to
 * English (listed as a warning). `{name}` placeholders must match between the two languages. Plain Node (no tsx):
 * only type annotations that Node can strip.
 */
import { readFileSync, writeFileSync } from "node:fs";

const CSV = "app/_i18n/messages.csv";
const KEYS_OUT = "app/_i18n/message-keys.ts";
const MESSAGES_OUT = "app/_i18n/messages.ts";
const HEADER = ["key", "en", "ko", "note"];
const KEY_PATTERN = /^[a-z][A-Za-z0-9]*(\.[A-Za-z0-9]+)+$/;
/** Absolute principle 1: a candidate is never "detected" or "discovered". */
const CANDIDATE_EN = /candidate/i;
const CANDIDATE_KO_FORBIDDEN = /감지|발견/;

type Row = { key: string; en: string; ko: string; note: string; line: number };

function parseCsv(text: string): { cells: string[]; line: number }[] {
  const records: { cells: string[]; line: number }[] = [];
  let cells: string[] = [];
  let cell = "";
  let quoted = false;
  let line = 1;
  let start = 1;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (quoted) {
      if (c === '"' && text[i + 1] === '"') {
        cell += '"';
        i++;
      } else if (c === '"') {
        quoted = false;
      } else {
        if (c === "\n") line++;
        cell += c;
      }
    } else if (c === '"' && cell === "") {
      quoted = true;
    } else if (c === ",") {
      cells.push(cell);
      cell = "";
    } else if (c === "\n" || c === "\r") {
      if (c === "\r" && text[i + 1] === "\n") i++;
      cells.push(cell);
      if (cells.some((value) => value !== "")) records.push({ cells, line: start });
      cells = [];
      cell = "";
      line++;
      start = line;
    } else {
      cell += c;
    }
  }
  if (quoted) throw new Error(`${CSV}: a quoted cell starting near line ${start} is never closed`);
  cells.push(cell);
  if (cells.some((value) => value !== "")) records.push({ cells, line: start });
  return records;
}

const quote = (value: string) => (/[",\n\r]|^\s|\s$/.test(value) ? `"${value.replaceAll('"', '""')}"` : value);
const placeholders = (value: string) => [...value.matchAll(/\{(\w+)\}/g)].map((match) => match[1]).sort().join(",");

function read(): Row[] {
  const bytes = readFileSync(CSV);
  let text: string;
  try {
    text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
  } catch {
    throw new Error(`${CSV} is not UTF-8 (saved by Excel?). Save it as UTF-8 and run again.`);
  }
  if (text.charCodeAt(0) === 0xfeff) text = text.slice(1);
  const [head, ...records] = parseCsv(text);
  if (!head || head.cells.join(",") !== HEADER.join(",")) throw new Error(`${CSV}: the header must be ${HEADER.join(",")}`);
  return records.map(({ cells, line }) => {
    if (cells.length !== HEADER.length) throw new Error(`${CSV}:${line}: ${cells.length} cells, expected ${HEADER.length}`);
    const [key, en, ko, note] = cells;
    return { key, en, ko, note, line };
  });
}

function check(rows: Row[]) {
  const errors: string[] = [];
  const warnings: string[] = [];
  const seen = new Set<string>();
  for (const row of rows) {
    const at = `${CSV}:${row.line} ${row.key}`;
    if (!KEY_PATTERN.test(row.key)) errors.push(`${at}: key must look like area.name (letters and digits, dot-separated)`);
    if (seen.has(row.key)) errors.push(`${at}: duplicate key`);
    seen.add(row.key);
    if (!row.en.trim()) errors.push(`${at}: English text is empty`);
    if (!row.ko.trim()) warnings.push(`${row.key}: no Korean yet, English is shown`);
    else if (placeholders(row.en) !== placeholders(row.ko)) errors.push(`${at}: placeholders differ (en {${placeholders(row.en)}}, ko {${placeholders(row.ko)}})`);
    if (CANDIDATE_EN.test(row.en) && CANDIDATE_KO_FORBIDDEN.test(row.ko)) {
      errors.push(`${at}: a candidate is never "감지" or "발견" (absolute principle 1); use 후보`);
    }
  }
  return { errors, warnings };
}

function generate(rows: Row[]) {
  const banner = `// Generated by scripts/i18n.mts from ${CSV}. Do not edit: change the CSV and run \`pnpm i18n\`.\n`;
  const keys = `${banner}\nexport type MessageKey =\n${rows.map((row) => `  | ${JSON.stringify(row.key)}`).join("\n")};\n`;
  const dictionary = (pick: (row: Row) => string) =>
    `{\n${rows.map((row) => `  ${JSON.stringify(row.key)}: ${JSON.stringify(pick(row))},`).join("\n")}\n}`;
  const messages =
    `${banner}import "server-only";\n\nimport type { MessageKey } from "./message-keys";\n\n` +
    `export type Messages = Record<MessageKey, string>;\n\n` +
    `export const en: Messages = ${dictionary((row) => row.en)};\n\n` +
    `/** Rows with no Korean yet show the English text. */\n` +
    `export const ko: Messages = ${dictionary((row) => row.ko.trim() ? row.ko : row.en)};\n`;
  const csv = `${[HEADER, ...rows.map((row) => [row.key, row.en, row.ko, row.note])].map((cells) => cells.map(quote).join(",")).join("\n")}\n`;
  return { keys, messages, csv };
}

const checkOnly = process.argv.includes("--check");
const rows = read().sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
const { errors, warnings } = check(rows);
for (const warning of warnings) console.warn(`warning: ${warning}`);
if (errors.length > 0) {
  for (const error of errors) console.error(`error: ${error}`);
  process.exit(1);
}
const out = generate(rows);
const current = (path: string) => {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return "";
  }
};
if (checkOnly) {
  const stale = [
    [CSV, out.csv],
    [KEYS_OUT, out.keys],
    [MESSAGES_OUT, out.messages],
  ].filter(([path, text]) => current(path) !== text);
  if (stale.length > 0) {
    console.error(`error: run \`pnpm i18n\`; out of date: ${stale.map(([path]) => path).join(", ")}`);
    process.exit(1);
  }
  console.log(`i18n: ${rows.length} keys, up to date`);
} else {
  writeFileSync(CSV, out.csv);
  writeFileSync(KEYS_OUT, out.keys);
  writeFileSync(MESSAGES_OUT, out.messages);
  console.log(`i18n: ${rows.length} keys → ${KEYS_OUT}, ${MESSAGES_OUT}`);
}
