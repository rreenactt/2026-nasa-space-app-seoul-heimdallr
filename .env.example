# App name in page titles and the UI. Defaults to Web App. It is fixed at build time, so rebuild after changing it.
NEXT_PUBLIC_APP_NAME=

# Prisma (PostgreSQL on Neon). Leave both empty to run without a database.
# - DATABASE_URL: the app runtime (Prisma Client). Neon's pooled connection string (host ends in `-pooler`).
# - DIRECT_URL: the Prisma CLI (migrate and others). Neon's direct connection string (host without `-pooler`).
DATABASE_URL=
DIRECT_URL=
# Connections each app instance may open (default 3). Every instance has its own pool, so keep the number of instances
# times this value within the database's (or pooler's) client limit.
DATABASE_POOL_MAX=
# For the local development database (docker-compose.yaml, `pnpm docker:db`), set the two values above to these.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app

# Cloudflare R2 object storage (lib/storage.ts), server-only. Set all four of the first group or leave all empty.
# Create an R2 API token (Cloudflare dashboard > R2 > Manage API tokens) with Object Read & Write on this bucket only,
# and copy its S3 access key ID and secret. On Vercel, add them under Project Settings > Environment Variables.
# - R2_ACCOUNT_ID: 32-character Cloudflare account ID (R2 overview page).
# - R2_BUCKET: bucket name.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Public base URL of the bucket (its r2.dev URL or a custom domain). The browser loads objects from here;
# left empty, objects are only reachable through server code.
R2_PUBLIC_URL=
# 1 lets this server store the analysis responses it computes in R2, so places precomputed once (test targets, survey
# candidates) open without reading the archives again. Only for `scripts/precompute-analyses.ts` runs on a local
# server; leave empty in production, where the stored responses are only read.
RESPONSE_CACHE_WRITE=
# Cloudflare API token. Not read by the app; for managing the bucket through the Cloudflare API.
CLOUDFLARE_API_TOKEN=

# Whether the /design-system showcase is public. 1 opens it. Left empty, production builds answer 404, while the
# development server (pnpm dev) always opens it. It is fixed at build time, so rebuild after changing it.
NEXT_PUBLIC_DESIGN_SYSTEM=
